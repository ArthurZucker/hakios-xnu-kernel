# HakiOS fragment: the MediaTek MT6877 family -- what is true of the SoC, whatever device it is in.
#
# Nothing in the common kernel was written for a MediaTek SoC. The symbols below are the ones that are a fact of this
# chip rather than of the HiBreak Pro; set them only once the kernel's own support for them exists, and keep the ones
# that are still Qualcomm-shaped commented out. See devices/b651/SCOPE.md for the list of what has to be written.
CONFIG_SOC="mt6877"

# the Dimensity 900 has 8 cores: 2x Cortex-A78 (cores 6 and 7) and 6x Cortex-A55. The loader keeps core 0, so the
# kernel runs on core 7. This is the same shape as the reference SoC and needs no new code.
CONFIG_CPUS=8
CONFIG_BOOTCPU=7

# CONFIG_HAKIOS_CPUFREQ is not set      # hakios.cpufreq.c drives the Qualcomm cpufreqhw mailbox; MTK uses PPM/pwrap
# CONFIG_HAKIOS_SOCINFO is not set      # hakios.socinfo.c reads Qualcomm SMEM item 137; MTK uses the boot tag / ATAG
# CONFIG_HAKIOS_THERMAL is not set      # hakios.thermal.c reads Qualcomm TM0/TM1 + RPMh; MTK uses the LVTS + thermctl
# CONFIG_HAKIOS_PMIC is not set         # hakios.pmic.c walks the Qualcomm SPMI arbiter; MTK uses PMIF over SPI
