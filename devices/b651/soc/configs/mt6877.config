# HakiOS fragment: the MediaTek MT6877 family -- what is true of the SoC, whatever device it is in.
#
# Nothing in the common kernel was written for a MediaTek SoC. The symbols below are the ones that are a fact of this
# chip rather than of the HiBreak Pro; set them only once the kernel's own support for them exists, and keep the ones
# that are still Qualcomm-shaped commented out. See devices/b651/SCOPE.md for the list of what has to be written, and
# HARDWARE.md for where each claim below was verified.
CONFIG_SOC="mt6877"

# the MT6877 has 8 cores, and the device tree calls the big ones Cortex-A76 (not A78), at reg 0x600 and 0x700.
# The loader keeps core 0, so the kernel runs on core 7. Same shape as the reference SoC, so no new code.
CONFIG_CPUS=8
CONFIG_BOOTCPU=7

# The blocks below are what the common kernel's drivers assume and this SoC does not have. Sources in HARDWARE.md.
# CONFIG_HAKIOS_CPUFREQ is not set      # vendor `mediatek,mt-cpufreq` + MCUPM mailbox 0x0c540000 + DVFSP; not the
#                                      # Qualcomm cpufreqhw mailbox, and not generic cpufreq-dt either
# CONFIG_HAKIOS_SOCINFO is not set      # no Qualcomm SMEM item 137; identification is efuse/devinfo at 0x11f10000
# CONFIG_HAKIOS_THERMAL is not set      # node is `therm_ctrl@1100b000` (mediatek,therm_ctrl); there is no `lvts`
# CONFIG_HAKIOS_PMIC is not set         # not one SPMI arbiter: MT6359P on pwrap 0x10026000, MT6315 x2 on PMIF
#                                      # 0x10027000, MT6360 charger on i2c5 -- three buses, three drivers
