# HakiOS defconfig for QEMU's virt machine: the common kernel with the drivers of a virtual machine built in and none of a phone's.
# What a device's defconfig looks like when it chooses its drivers (docs/drivers-config.md): the phone's drivers are left out of
# the kernel, not only switched off at boot, and the arguments that only they read go with them (the check refuses them otherwise).
#include common_defconfig
#include open.config
#include virt.config
CONFIG_DEVICE="qemu"
# CONFIG_UFS is not set
# CONFIG_TOUCHSCREEN is not set
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_BUTTONS is not set
# CONFIG_HAKIOS_UFS is not set
# CONFIG_HAKIOS_ADRENO is not set
# The e-ink panel's driver, on the simulator's model backend: QEMU has no EPDC, and epd=1 epd_model=1 exercises the
# ABI, the marker in flight, EBUSY and the wait on a machine that cannot be damaged. The phone's own defconfig leaves
# the driver out until its dtbo has been read (devices/b651/EPDC.md).
CONFIG_HAKIOS_EPD=y
CONFIG_EPD=y
CONFIG_EPD_MODEL=y
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BATTERY is not set
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_WIFI is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
